# The relayer pays gas from this account. Provide the key here, or as ~/.near-credentials/testnet/<account>.json
RELAYER_ACCOUNT=nme-relayer.testnet
RELAYER_KEY=ed25519:...
GATEWAY=gateway.nme.testnet
ARENA=arena.nme.testnet
NEAR_RPC=https://rpc.testnet.fastnear.com
SOLANA_RPC=https://api.devnet.solana.com
EVM_RPC=https://ethereum-sepolia-rpc.publicnode.com
PORT=8787
RATE_PER_MIN=6
RATE_PER_DAY=100
IP_PER_MIN=30
GLOBAL_PER_MIN=120
CORS_ORIGIN=*
# TRUST_PROXY=1   # read the client address from X-Forwarded-For (only behind your own proxy)
